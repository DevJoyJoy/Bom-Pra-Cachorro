# Copy this file to .env.local and replace these values with your Firebase web app settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Required only for uploading pet photos; omit to test pet records without photos.
VITE_FIREBASE_STORAGE_BUCKET=
# Used only by `npm run create:test-admin`; keep the password in ignored .env.local.
TEST_ADMIN_EMAIL=useradmin@example.com
TEST_ADMIN_PASSWORD=
